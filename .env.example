# Public client IDs used by frontend (safe to expose)
VITE_OAUTH_GITHUB_CLIENT_ID=
VITE_OAUTH_GOOGLE_CLIENT_ID=
# Optional. Origin hosting auth-callback.html; defaults to the current origin.
VITE_OAUTH_CALLBACK_ORIGIN=
#
# Register this exact redirect URI with each provider's console (no query string,
# no trailing slash variance):
#   https://<your-domain>/auth-callback.html
# GitHub: Settings > Developer settings > OAuth Apps > Authorization callback URL
# Google: APIs & Services > Credentials > OAuth 2.0 Client > Authorized redirect URIs

# Server-side OAuth credentials (do NOT prefix with VITE_)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
LITEMORA_SESSION_SECRET=
