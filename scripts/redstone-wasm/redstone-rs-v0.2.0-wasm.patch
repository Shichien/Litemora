+++ b/crates/redstone-io/src/progress.rs
@@ -0,0 +1,35 @@
+//! 终端进度条在 wasm32 上不可用, 这里提供同名的空实现.
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) use tracing_indicatif::{span_ext::IndicatifSpanExt, style::ProgressStyle};
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) use noop::{IndicatifSpanExt, ProgressStyle};
+
+#[cfg(target_arch = "wasm32")]
+mod noop {
+    use std::convert::Infallible;
+
+    pub(crate) struct ProgressStyle;
+
+    impl ProgressStyle {
+        pub(crate) fn with_template(_template: &str) -> Result<Self, Infallible> {
+            Ok(Self)
+        }
+
+        pub(crate) fn progress_chars(self, _chars: &str) -> Self {
+            self
+        }
+    }
+
+    pub(crate) trait IndicatifSpanExt {
+        fn pb_set_style(&self, _style: &ProgressStyle) {}
+        fn pb_set_length(&self, _length: u64) {}
+        fn pb_set_position(&self, _position: u64) {}
+        fn pb_set_message(&self, _message: &str) {}
+        fn pb_set_finish_message(&self, _message: &str) {}
+        fn pb_start(&self) {}
+    }
+
+    impl IndicatifSpanExt for tracing::Span {}
+}
