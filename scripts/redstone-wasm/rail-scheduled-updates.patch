+fn assert_rail_slope_power_change(initially_powered: bool) {
+    for rail_name in ["minecraft:powered_rail", "minecraft:activator_rail"] {
+        for from_high_end in [true, false] {
+            let mut registry = Java26Registry::new();
+            let powered = if initially_powered { "true" } else { "false" };
+            let flat = state(
+                &mut registry,
+                rail_name,
+                &[
+                    ("powered", powered),
+                    ("shape", "north_south"),
+                    ("waterlogged", "false"),
+                ],
+            );
+            let slope = state(
+                &mut registry,
+                rail_name,
+                &[
+                    ("powered", powered),
+                    ("shape", "ascending_north"),
+                    ("waterlogged", "false"),
+                ],
+            );
+            let stone = state(&mut registry, "minecraft:stone", &[]);
+            let source = state(&mut registry, "minecraft:redstone_block", &[]);
+            let rails = [
+                (BlockPos::new(0, 2, 0), flat),
+                (BlockPos::new(0, 1, 1), slope),
+                (BlockPos::new(0, 1, 2), flat),
+            ];
+            let source_pos = if from_high_end {
+                BlockPos::new(0, 2, -1)
+            } else {
+                BlockPos::new(0, 1, 3)
+            };
+            let mut world = SparseWorld::new(registry.air_state());
+            for (pos, rail) in rails {
+                world
+                    .set_block(pos.relative(Direction::Down), stone)
+                    .unwrap();
+                world.set_block(pos, rail).unwrap();
+            }
+            if initially_powered {
+                world.set_block(source_pos, source).unwrap();
+            }
+            let mut simulation = Simulation::load(
+                Java26Rules::new(registry),
+                world,
+                SimulationConfig::default(),
+            )
+            .unwrap();
+
+            // Do not initialize every rail: one source update must cross the slope.
+            let action = if initially_powered {
+                Action::BreakBlock { pos: source_pos }
+            } else {
+                Action::SetBlock {
+                    pos: source_pos,
+                    state: source,
+                }
+            };
+            simulation.step_with_actions(&[action]).unwrap();
+
+            for (pos, _) in rails {
+                let rail = simulation
+                    .rules()
+                    .registry()
+                    .state(simulation.world().get_block(pos))
+                    .unwrap();
+                assert_eq!(
+                    rail.property("powered"),
+                    Some(if initially_powered { "false" } else { "true" }),
+                    "{rail_name} at {pos:?}, from_high_end={from_high_end}",
+                );
+            }
+        }
+    }
+}
