+#[test]
+fn piston_started_observer_clock_repeats_every_four_game_ticks() {
+    let mut registry = Java26Registry::new();
+    let fixed = state(
+        &mut registry,
+        "minecraft:observer",
+        &[("facing", "south"), ("powered", "false")],
+    );
+    let moved = state(
+        &mut registry,
+        "minecraft:observer",
+        &[("facing", "north"), ("powered", "false")],
+    );
+    let piston = state(
+        &mut registry,
+        "minecraft:piston",
+        &[("facing", "down"), ("extended", "false")],
+    );
+    let source = state(&mut registry, "minecraft:redstone_block", &[]);
+    let fixed_pos = BlockPos::new(1, 2, 0);
+    let moved_pos = BlockPos::new(1, 2, 1);
+    let source_pos = BlockPos::new(1, 4, 0);
+    let mut world = SparseWorld::new(registry.air_state());
+    world.set_block(fixed_pos, fixed).unwrap();
+    world.set_block(BlockPos::new(1, 3, 1), moved).unwrap();
+    world.set_block(BlockPos::new(1, 4, 1), piston).unwrap();
+    let mut simulation = Simulation::load(
+        Java26Rules::new(registry),
+        world,
+        SimulationConfig::default(),
+    )
+    .unwrap();
+    let mut fixed_rises = Vec::new();
+    let mut moved_rises = Vec::new();
+    for tick in 1..=50 {
+        let actions = match tick {
+            20 => vec![Action::SetBlock {
+                pos: source_pos,
+                state: source,
+            }],
+            24 => vec![Action::BreakBlock { pos: source_pos }],
+            _ => Vec::new(),
+        };
+        let delta = simulation.step_with_actions(&actions).unwrap();
+        for event in delta.events {
+            let WorldEvent::Block { change } = event else {
+                continue;
+            };
+            if change.pos != fixed_pos && change.pos != moved_pos {
+                continue;
+            }
+            let state = simulation
+                .rules()
+                .registry()
+                .state(change.new_state)
+                .unwrap();
+            if state.name.as_ref() == "minecraft:observer"
+                && state.property("powered") == Some("true")
+            {
+                if change.pos == fixed_pos {
+                    fixed_rises.push(tick);
+                } else {
+                    moved_rises.push(tick);
+                }
+            }
+        }
+    }
+    // At tick 24 the fixed observer turns off before the moved observer turns on.
+    // Both due ticks have already left the pending set, so the shape update can
+    // schedule the moved observer again for tick 26, preserving a four-tick clock.
+    assert_eq!(fixed_rises, vec![22, 26, 30, 34, 38, 42, 46, 50]);
+    assert_eq!(moved_rises, vec![24, 28, 32, 36, 40, 44, 48]);
+}
