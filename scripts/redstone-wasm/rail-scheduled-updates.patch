+#[test]
+fn powered_rails_propagate_power_on_across_a_slope_in_both_directions() {
+    assert_rail_slope_power_change(false);
+}
+
+#[test]
+fn powered_rails_propagate_power_off_across_a_slope_in_both_directions() {
+    assert_rail_slope_power_change(true);
+}
