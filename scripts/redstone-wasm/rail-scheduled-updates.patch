+#[test]
+fn diodes_do_not_reschedule_ticks_still_in_the_current_batch() {
+    for mode in [
+        redstone_core::ExecutionMode::Interpreted,
+        redstone_core::ExecutionMode::Compiled,
+    ] {
+        for target_name in ["minecraft:repeater", "minecraft:comparator"] {
+            let mut registry = Java26Registry::new();
+            let first = state(
+                &mut registry,
+                "minecraft:repeater",
+                &[
+                    ("facing", "east"),
+                    ("powered", "false"),
+                    ("locked", "false"),
+                    ("delay", "1"),
+                ],
+            );
+            let target = if target_name == "minecraft:repeater" {
+                state(
+                    &mut registry,
+                    target_name,
+                    &[
+                        ("facing", "north"),
+                        ("powered", "false"),
+                        ("locked", "false"),
+                        ("delay", "1"),
+                    ],
+                )
+            } else {
+                state(
+                    &mut registry,
+                    target_name,
+                    &[
+                        ("facing", "north"),
+                        ("powered", "false"),
+                        ("mode", "compare"),
+                    ],
+                )
+            };
+            let source = state(&mut registry, "minecraft:redstone_block", &[]);
+            let stone = state(&mut registry, "minecraft:stone", &[]);
+            let target_pos = BlockPos::new(0, 1, 0);
+            let mut world = SparseWorld::new(registry.air_state());
+            for pos in [
+                BlockPos::new(0, 0, 0),
+                BlockPos::new(1, 0, 1),
+                BlockPos::new(0, 1, 1),
+            ] {
+                world.set_block(pos, stone).unwrap();
+            }
+            world.set_block(BlockPos::new(1, 1, 1), first).unwrap();
+            world.set_block(target_pos, target).unwrap();
+            let mut simulation = Simulation::load(
+                Java26Rules::new(registry),
+                world,
+                SimulationConfig {
+                    execution_mode: mode,
+                    ..SimulationConfig::default()
+                },
+            )
+            .unwrap();
+            simulation
+                .step_with_actions(&[
+                    Action::SetBlock {
+                        pos: BlockPos::new(2, 1, 1),
+                        state: source,
+                    },
+                    Action::SetBlock {
+                        pos: BlockPos::new(0, 1, -1),
+                        state: source,
+                    },
+                ])
+                .unwrap();
+            assert_eq!(simulation.pending_scheduled_ticks(), 2);
+            simulation.step().unwrap();
+            simulation.step().unwrap();
+
+            // The first repeater broadcasts around its output at (0,1,1),
+            // refreshing the target before its already-collected tick runs.
+            assert_eq!(
+                simulation
+                    .rules()
+                    .registry()
+                    .state(simulation.world().get_block(target_pos),)
+                    .unwrap()
+                    .property("powered"),
+                Some("true")
+            );
+            assert_eq!(
+                simulation.pending_scheduled_ticks(),
+                0,
+                "{target_name}, {mode:?}"
+            );
+        }
+    }
+}
