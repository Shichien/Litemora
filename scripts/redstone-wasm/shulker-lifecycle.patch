+#[test]
+fn shulker_piston_destruction_preserves_cargo_for_hopper_collection() {
+    let mut registry = Java26Registry::new();
+    let piston = state(&mut registry, "minecraft:piston", &[("facing", "west")]);
+    let box_state = state(&mut registry, "minecraft:gray_shulker_box", &[]);
+    let hopper = state(&mut registry, "minecraft:hopper", &[("facing", "down")]);
+    let comparator = state(
+        &mut registry,
+        "minecraft:comparator",
+        &[("facing", "north")],
+    );
+    let stone = state(&mut registry, "minecraft:stone", &[]);
+    let comparator_pos = BlockPos::new(0, 0, 1);
+    let power = state(&mut registry, "minecraft:redstone_block", &[]);
+    let box_pos = BlockPos::ZERO;
+    let hopper_pos = BlockPos::new(0, -1, 0);
+    let contents = filled_components();
+    let entries = contents["minecraft:container"].as_array().unwrap().iter().map(|entry| json!({
+        "slot": entry["slot"], "item_id": entry["item"]["id"], "count": entry["item"]["count"], "components": entry["item"]["components"]
+    })).collect::<Vec<_>>();
+    let mut data = container("minecraft:shulker_box", 27, json!(entries));
+    data.fields.insert(
+        "CustomName".to_owned(),
+        contents["minecraft:custom_name"].clone(),
+    );
+    data.fields
+        .insert("lock".to_owned(), contents["minecraft:lock"].clone());
+    let mut world = SparseWorld::new(registry.air_state());
+    world.set_block(box_pos, box_state).unwrap();
+    world.set_block(BlockPos::new(1, 0, 0), piston).unwrap();
+    world.set_block(comparator_pos, comparator).unwrap();
+    world
+        .set_block(comparator_pos.relative(Direction::Down), stone)
+        .unwrap();
+    world.set_block_entity(box_pos, data);
+    let mut sim = simulation(registry, world);
+    sim.run_until(GameTick(3)).unwrap();
+    assert_eq!(
+        sim.rules().comparator_output_cache().get(&comparator_pos),
+        Some(&15)
+    );
+    sim.apply(Action::SetBlock {
+        pos: BlockPos::new(2, 0, 0),
+        state: power,
+    })
+    .unwrap();
+    sim.run_until(GameTick(6)).unwrap();
+    assert_eq!(
+        sim.rules()
+            .comparator_output_cache()
+            .get(&comparator_pos)
+            .copied()
+            .unwrap_or(0),
+        0
+    );
+    assert_eq!(sim.world().entities().count(), 1);
+    assert_eq!(
+        sim.world().entities().next().unwrap().1.fields["item_components"],
+        contents
+    );
+    assert_ne!(
+        sim.rules()
+            .registry()
+            .state(sim.world().get_block(box_pos))
+            .unwrap()
+            .name
+            .as_ref(),
+        "minecraft:gray_shulker_box"
+    );
+    // Collect after the piston retracts, so the hopper has no block container above it.
+    sim.apply(Action::BreakBlock {
+        pos: BlockPos::new(2, 0, 0),
+    })
+    .unwrap();
+    sim.run_until(GameTick(9)).unwrap();
+    sim.apply(Action::SetBlock {
+        pos: hopper_pos,
+        state: hopper,
+    })
+    .unwrap();
+    sim.apply(Action::SetBlockEntity {
+        pos: hopper_pos,
+        data: container("minecraft:hopper", 5, json!([])),
+    })
+    .unwrap();
+    sim.run_until(GameTick(16)).unwrap();
+    assert_eq!(sim.world().entities().count(), 0);
+    assert_eq!(count(&sim, hopper_pos), 1);
+    let collected = &sim.world().block_entity(hopper_pos).unwrap().fields["inventory"][0];
+    assert_eq!(collected["item_id"], "minecraft:gray_shulker_box");
+    assert_eq!(collected["components"], contents);
+}
