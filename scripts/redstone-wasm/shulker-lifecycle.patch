diff --git a/crates/redstone-java-26/src/rules/inventory/shulker.rs b/crates/redstone-java-26/src/rules/inventory/shulker.rs
new file mode 100644
index 0000000..3f3002b
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/inventory/shulker.rs
@@ -0,0 +1,284 @@
+use std::collections::BTreeMap;
+
+use redstone_core::{BlockEntityData, BlockPos, Direction, EventContext, RulesError};
+use serde_json::{Map, Value};
+
+use super::{
+    ItemStack, direction_name, inventory, is_shulker_box_item, spawn_item_stack, write_inventory,
+};
+use crate::rules::{BlockBehavior, Java26Rules, StateDefinition};
+
+impl Java26Rules {
+    pub(super) fn dispense_shulker_box(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        target: BlockPos,
+        dispenser_facing: Direction,
+        stack: &ItemStack,
+    ) -> Result<bool, RulesError> {
+        // DirectionalPlaceContext never searches another position when this one is occupied.
+        if !can_replace_with_shulker(self.state(ctx.world.get_block(target))?) {
+            return Ok(false);
+        }
+        let components = match stack.components.as_ref() {
+            None => Map::new(),
+            Some(Value::Object(components)) => components.clone(),
+            Some(_) => {
+                ctx.unsupported(target, "shulker_box_components");
+                return Ok(false);
+            }
+        };
+        let Some(contents) = container_contents(components.get("minecraft:container")) else {
+            ctx.unsupported(target, "shulker_box_container_component");
+            return Ok(false);
+        };
+        // ShulkerBoxDispenseBehavior uses isEmptyBlock, not a support-face test.
+        let below = self.state(ctx.world.get_block(target.relative(Direction::Down)))?;
+        let facing = if matches!(below.behavior, BlockBehavior::Air) {
+            dispenser_facing
+        } else {
+            Direction::Up
+        };
+        let placed = self
+            .registry
+            .state_by_name(&stack.item_id, [("facing", direction_name(facing))])
+            .map_err(|error| RulesError::Message(error.to_string()))?;
+        if !self.set_state_and_notify(ctx, target, placed, "dispenser_shulker_box", None)? {
+            return Ok(false);
+        }
+        // BlockItem applies BLOCK_STATE after its initial placement. Invalid properties are ignored.
+        if let Some(facing) = components
+            .get("minecraft:block_state")
+            .and_then(|value| value.get("facing"))
+            .and_then(Value::as_str)
+            .filter(|value| matches!(*value, "down" | "up" | "north" | "south" | "west" | "east"))
+        {
+            let state = self.changed_state(placed, "facing", facing)?;
+            self.set_block(ctx, target, state, "shulker_box_block_state_component")?;
+        }
+        let mut fields = BTreeMap::from([
+            ("slot_count".to_owned(), Value::from(27)),
+            ("capacity".to_owned(), Value::from(27 * 64)),
+        ]);
+        // BaseContainerBlockEntity.applyImplicitComponents replaces name/lock/Items from the
+        // custom block entity tag, even when the item component is absent. LootTable survives.
+        if let Some(tag) = components
+            .get("minecraft:block_entity_data")
+            .and_then(Value::as_object)
+            .filter(|tag| tag.get("id").and_then(Value::as_str) == Some("minecraft:shulker_box"))
+        {
+            for key in ["LootTable", "LootTableSeed"] {
+                if let Some(value) = tag.get(key) {
+                    fields.insert(key.to_owned(), value.clone());
+                }
+            }
+        }
+        for (component, field) in [
+            ("minecraft:custom_name", "CustomName"),
+            ("minecraft:lock", "lock"),
+        ] {
+            if let Some(value) = components.get(component) {
+                fields.insert(field.to_owned(), value.clone());
+            }
+        }
+        if let Some(loot) = components.get("minecraft:container_loot") {
+            if let Some(table) = loot.get("loot_table") {
+                fields.insert("LootTable".to_owned(), table.clone());
+                fields.insert(
+                    "LootTableSeed".to_owned(),
+                    loot.get("seed").cloned().unwrap_or(Value::from(0)),
+                );
+            }
+        }
+        let retained = components
+            .into_iter()
+            .filter(|(key, _)| {
+                !key.starts_with('!')
+                    && !matches!(
+                        key.as_str(),
+                        "minecraft:container"
+                            | "minecraft:custom_name"
+                            | "minecraft:lock"
+                            | "minecraft:container_loot"
+                            | "minecraft:block_entity_data"
+                            | "minecraft:block_state"
+                    )
+            })
+            .collect::<Map<_, _>>();
+        if !retained.is_empty() {
+            fields.insert("components".to_owned(), Value::Object(retained));
+        }
+        ctx.set_block_entity(
+            target,
+            BlockEntityData {
+                kind: "minecraft:shulker_box".to_owned(),
+                fields,
+            },
+        );
+        write_inventory(ctx, target, contents);
+        // The state notification happens before the item components are installed in vanilla too.
+        self.refresh_comparators_near(ctx, target)?;
+        Ok(true)
+    }
+
+    pub(in crate::rules) fn drop_shulker_box(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+    ) -> Result<(), RulesError> {
+        let state = self.state(ctx.world.get_block(pos))?;
+        if !is_shulker_box_item(&state.name) {
+            return Ok(());
+        }
+        let item_id = state.name.to_string();
+        let mut components = Map::new();
+        if let Some(data) = ctx.world.block_entity(pos) {
+            for (field, component) in [
+                ("CustomName", "minecraft:custom_name"),
+                ("lock", "minecraft:lock"),
+            ] {
+                if let Some(value) = data.fields.get(field) {
+                    components.insert(component.to_owned(), value.clone());
+                }
+            }
+            if let Some(table) = data
+                .fields
+                .get("LootTable")
+                .or_else(|| data.fields.get("loot_table"))
+            {
+                components.insert(
+                    "minecraft:container_loot".to_owned(),
+                    serde_json::json!({
+                        "loot_table": table,
+                        "seed": data.fields.get("LootTableSeed").cloned().unwrap_or(Value::from(0)),
+                    }),
+                );
+            }
+        }
+        // The official block loot table copies only these four components, not every component
+        // retained on the block entity. Nested item components are part of CONTAINER itself.
+        let contents = inventory(ctx.world, pos)
+            .into_iter()
+            .map(|stack| {
+                let mut item = Map::from_iter([
+                    ("id".to_owned(), Value::String(stack.item_id)),
+                    ("count".to_owned(), Value::from(stack.count)),
+                ]);
+                if let Some(components) = stack.components {
+                    item.insert("components".to_owned(), components);
+                }
+                serde_json::json!({"slot": stack.slot, "item": item})
+            })
+            .collect::<Vec<_>>();
+        components.insert("minecraft:container".to_owned(), Value::Array(contents));
+        spawn_item_stack(
+            ctx.world,
+            pos,
+            ItemStack {
+                slot: 0,
+                item_id,
+                count: 1,
+                components: Some(Value::Object(components)),
+            },
+        );
+        Ok(())
+    }
+}
+
+fn container_contents(value: Option<&Value>) -> Option<Vec<ItemStack>> {
+    let Some(value) = value else {
+        return Some(Vec::new());
+    };
+    let entries = value.as_array()?;
+    if entries.len() > 256 {
+        return None;
+    }
+    let mut slots = BTreeMap::new();
+    for entry in entries {
+        let slot: u32 = entry.get("slot")?.as_u64()?.try_into().ok()?;
+        if slot >= 256 {
+            return None;
+        }
+        // ItemStackTemplate.CODEC also accepts an item id string with count one.
+        let (item_id, count, components) = match entry.get("item")? {
+            Value::String(id) => (id.as_str(), 1, None),
+            Value::Object(item) => {
+                let count = match item.get("count") {
+                    Some(value) => value.as_i64()?,
+                    None => 1,
+                };
+                let components = item.get("components");
+                if components.is_some_and(|value| !value.is_object()) {
+                    return None;
+                }
+                (item.get("id")?.as_str()?, count, components.cloned())
+            }
+            _ => return None,
+        };
+        if !(1..=99).contains(&count) || item_id.is_empty() {
+            return None;
+        }
+        let item_id = if item_id.contains(':') {
+            item_id.to_owned()
+        } else {
+            format!("minecraft:{item_id}")
+        };
+        if item_id == "minecraft:air" {
+            return None;
+        }
+        // ItemContainerContents.copyInto copies the 27 destination slots; duplicate slots use
+        // the last value in the component, and entries beyond the destination are not copied.
+        if slot < 27 {
+            slots.insert(
+                slot,
+                ItemStack {
+                    slot,
+                    item_id,
+                    count,
+                    components,
+                },
+            );
+        }
+    }
+    Some(slots.into_values().collect())
+}
+
+fn can_replace_with_shulker(state: &StateDefinition) -> bool {
+    // 26.1.2 Blocks properties plus canBeReplaced overrides. Solidity and piston DESTROY are
+    // not replacement tests: rails, carpets, flowers and redstone components stay in place.
+    match state.name.as_ref() {
+        "minecraft:snow" => state.int_property("layers") == Some(1),
+        "minecraft:vine" => ["up", "north", "south", "west", "east"]
+            .into_iter()
+            .any(|face| !state.bool_property(face)),
+        "minecraft:air"
+        | "minecraft:cave_air"
+        | "minecraft:void_air"
+        | "minecraft:water"
+        | "minecraft:lava"
+        | "minecraft:bubble_column"
+        | "minecraft:short_grass"
+        | "minecraft:fern"
+        | "minecraft:dead_bush"
+        | "minecraft:bush"
+        | "minecraft:short_dry_grass"
+        | "minecraft:tall_dry_grass"
+        | "minecraft:seagrass"
+        | "minecraft:tall_seagrass"
+        | "minecraft:tall_grass"
+        | "minecraft:large_fern"
+        | "minecraft:fire"
+        | "minecraft:soul_fire"
+        | "minecraft:glow_lichen"
+        | "minecraft:resin_clump"
+        | "minecraft:sculk_vein"
+        | "minecraft:light"
+        | "minecraft:structure_void"
+        | "minecraft:warped_roots"
+        | "minecraft:nether_sprouts"
+        | "minecraft:crimson_roots"
+        | "minecraft:leaf_litter"
+        | "minecraft:hanging_roots" => true,
+        _ => false,
+    }
+}
