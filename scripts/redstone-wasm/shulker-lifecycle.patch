index 0000000..678767c
--- /dev/null
+++ b/crates/redstone-java-26/tests/shulker.rs
@@ -0,0 +1,657 @@
+use std::collections::BTreeMap;
+
+use redstone_core::{
+    Action, BlockEntityData, BlockPos, BlockStateId, Direction, GameTick, Simulation,
+    SimulationConfig, SparseWorld, TraceKind,
+};
+use redstone_java_26::{Java26Registry, Java26Rules, StateResolver};
+use serde_json::{Value, json};
+
+fn state(registry: &mut Java26Registry, name: &str, properties: &[(&str, &str)]) -> BlockStateId {
+    let properties = registry
+        .complete_state_properties(
+            name,
+            &properties
+                .iter()
+                .map(|(k, v)| (k.to_string(), v.to_string()))
+                .collect(),
+        )
+        .unwrap();
+    registry.resolve_state(name, &properties).unwrap()
+}
+
+fn container(kind: &str, slots: i64, inventory: Value) -> BlockEntityData {
+    let count: i64 = inventory
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|stack| stack["count"].as_i64().unwrap())
+        .sum();
+    BlockEntityData {
+        kind: kind.to_owned(),
+        fields: BTreeMap::from([
+            ("inventory".to_owned(), inventory),
+            ("item_count".to_owned(), count.into()),
+            ("slot_count".to_owned(), slots.into()),
+            ("capacity".to_owned(), (slots * 64).into()),
+        ]),
+    }
+}
+
+fn stack(item: &str, count: i64, components: Value) -> Value {
+    json!({"slot": 0, "item_id": item, "count": count, "components": components})
+}
+
+fn filled_components() -> Value {
+    json!({
+        "minecraft:custom_name": {"text": "Cargo"},
+        "minecraft:lock": {"components": {"minecraft:custom_name": "Key"}},
+        "minecraft:container": (0..27).map(|slot| json!({"slot": slot, "item": {
+            "id": "minecraft:stone", "count": 64,
+            "components": {"minecraft:custom_name": {"text": format!("Batch {slot}")}, "minecraft:custom_data": {"batch": slot}}
+        }})).collect::<Vec<_>>()
+    })
+}
+
+fn simulation(registry: Java26Registry, world: SparseWorld) -> Simulation<Java26Rules> {
+    let mut sim = Simulation::load(
+        Java26Rules::new(registry),
+        world,
+        SimulationConfig::default(),
+    )
+    .unwrap();
+    sim.set_trace_enabled(true).unwrap();
+    sim.initialize().unwrap();
+    sim
+}
+
+fn count(sim: &Simulation<Java26Rules>, pos: BlockPos) -> i64 {
+    sim.world().block_entity(pos).unwrap().fields["item_count"]
+        .as_i64()
+        .unwrap()
+}
+
+fn placement(
+    item: &str,
+    components: Value,
+    facing: Direction,
+    target_block: &str,
+    target_properties: &[(&str, &str)],
+    below_block: &str,
+) -> (Simulation<Java26Rules>, BlockPos) {
+    let mut registry = Java26Registry::new();
+    let facing_name = match facing {
+        Direction::Down => "down",
+        Direction::Up => "up",
+        Direction::North => "north",
+        Direction::South => "south",
+        Direction::West => "west",
+        Direction::East => "east",
+    };
+    let dispenser = state(
+        &mut registry,
+        "minecraft:dispenser",
+        &[("facing", facing_name)],
+    );
+    let power = state(&mut registry, "minecraft:redstone_block", &[]);
+    let target_state = state(&mut registry, target_block, target_properties);
+    let below = state(&mut registry, below_block, &[]);
+    let target = BlockPos::ZERO.relative(facing);
+    let power_pos = BlockPos::ZERO.relative(if facing == Direction::North {
+        Direction::South
+    } else {
+        Direction::North
+    });
+    let mut world = SparseWorld::new(registry.air_state());
