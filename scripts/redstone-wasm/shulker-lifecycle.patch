+fn shulker_placement_and_removal_update_comparator_observer_and_neighbors() {
+    let mut registry = Java26Registry::new();
+    let dispenser = state(&mut registry, "minecraft:dispenser", &[("facing", "east")]);
+    let comparator = state(
+        &mut registry,
+        "minecraft:comparator",
+        &[("facing", "north")],
+    );
+    let observer = state(&mut registry, "minecraft:observer", &[("facing", "west")]);
+    let stone = state(&mut registry, "minecraft:stone", &[]);
+    let power = state(&mut registry, "minecraft:redstone_block", &[]);
+    let target = BlockPos::new(1, 0, 0);
+    let comparator_pos = BlockPos::new(1, 0, 1);
+    let observer_pos = BlockPos::new(2, 0, 0);
+    let mut world = SparseWorld::new(registry.air_state());
+    for (pos, block) in [
+        (BlockPos::ZERO, dispenser),
+        (comparator_pos, comparator),
+        (comparator_pos.relative(Direction::Down), stone),
+        (observer_pos, observer),
+        (BlockPos::new(0, 0, -1), power),
+    ] {
+        world.set_block(pos, block).unwrap();
+    }
+    world.set_block_entity(
+        BlockPos::ZERO,
+        container(
+            "minecraft:dispenser",
+            9,
+            json!([stack("minecraft:shulker_box", 1, filled_components())]),
+        ),
+    );
+    let mut sim = simulation(registry, world);
+    sim.run_until(GameTick(7)).unwrap();
+    assert_eq!(
+        sim.rules().comparator_output_cache().get(&comparator_pos),
+        Some(&15)
+    );
+    assert!(
+        sim.rules()
+            .registry()
+            .state(sim.world().get_block(observer_pos))
+            .unwrap()
+            .bool_property("powered")
+    );
+    for direction in [
+        Direction::Down,
+        Direction::Up,
+        Direction::North,
+        Direction::South,
+        Direction::West,
+        Direction::East,
+    ] {
+        assert!(sim.trace().events().iter().any(|event| matches!(event.kind, TraceKind::NeighborUpdate { pos, source_pos, .. } if source_pos == target && pos == target.relative(direction))));
+    }
+    sim.apply(Action::BreakBlock { pos: target }).unwrap();
+    sim.run_until(GameTick(11)).unwrap();
+    assert_eq!(
+        sim.rules()
+            .comparator_output_cache()
+            .get(&comparator_pos)
+            .copied()
+            .unwrap_or(0),
+        0
+    );
+}
