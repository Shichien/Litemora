diff --git a/crates/redstone-java-26/src/rules/armor_stand.rs b/crates/redstone-java-26/src/rules/armor_stand.rs
new file mode 100644
index 0000000..45cc545
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/armor_stand.rs
@@ -0,0 +1,109 @@
+use super::physics::{Bounds, dimensions, flag, motion, set_motion, shape_boxes, swept_entity};
+use super::*;
+
+fn has_water(state: &StateDefinition) -> bool {
+    matches!(
+        state.name.as_ref(),
+        "minecraft:water" | "minecraft:bubble_column"
+    ) || state.bool_property("waterlogged")
+}
+
+impl Java26Rules {
+    pub(super) fn tick_armor_stand(
+        &self,
+        ctx: &mut EventContext<'_>,
+        id: EntityId,
+    ) -> Result<(), RulesError> {
+        let stand = ctx.world.entity(id).unwrap();
+        if flag(stand, "Marker") || flag(stand, "NoGravity") {
+            return Ok(());
+        }
+        let pos = stand.position;
+        let [width, height] = dimensions(stand);
+        let grounded = flag(stand, "OnGround");
+        let mut velocity = motion(stand);
+        for v in &mut velocity {
+            if v.abs() < 0.003 {
+                *v = 0.0;
+            }
+        }
+        let support = |p: [f64; 3]| entity_block_pos([p[0], p[1] - 1e-5, p[2]]);
+        let initial_body = Bounds::entity(stand);
+        let in_water = initial_body.cells().any(|p| {
+            let s = self.registry.state(ctx.world.get_block(p)).unwrap();
+            has_water(s) && Bounds::at(p, [0.0; 3], [1.0; 3]).intersects(initial_body)
+        });
+        let ground_friction = match self.state(ctx.world.get_block(support(pos)))?.name.as_ref() {
+            "minecraft:ice" | "minecraft:packed_ice" | "minecraft:frosted_ice" => 0.98,
+            "minecraft:blue_ice" => 0.989,
+            "minecraft:slime_block" => 0.8,
+            _ => 0.6,
+        };
+        let (point, blocked) = swept_entity(ctx.world, pos, velocity, width, height);
+        let on_ground = blocked[1] && velocity[1] < 0.0;
+        let bounce = on_ground
+            && self
+                .state(ctx.world.get_block(support(point)))?
+                .name
+                .as_ref()
+                == "minecraft:slime_block";
+        for i in 0..3 {
+            if blocked[i] {
+                velocity[i] = if i == 1 && bounce { -velocity[i] } else { 0.0 };
+            }
+        }
+        if in_water {
+            velocity = velocity.map(|v| v * f64::from(0.8_f32));
+            velocity[1] -= 0.08 / 16.0;
+        } else {
+            let friction = f64::from(0.91_f32) * if grounded { ground_friction } else { 1.0 };
+            velocity[0] *= friction;
+            velocity[2] *= friction;
+            velocity[1] = (velocity[1] - 0.08) * f64::from(0.98_f32);
+        }
+        if pos != point {
+            ctx.world.move_entity(id, point);
+        }
+        if grounded != on_ground {
+            ctx.world
+                .entity_fields_mut(id)
+                .unwrap()
+                .insert("OnGround".into(), on_ground.into());
+        }
+        let body = Bounds::entity(ctx.world.entity(id).unwrap());
+        for cell in body.cells() {
+            let state = self.state(ctx.world.get_block(cell))?;
+            if state.name.as_ref() != "minecraft:bubble_column"
+                || !body.intersects(Bounds::at(cell, [0.0; 3], [1.0; 3]))
+            {
+                continue;
+            }
+            let above = self.state(ctx.world.get_block(cell.relative(Direction::Up)))?;
+            let surface = shape_boxes(above.id).is_empty()
+                && !has_water(above)
+                && above.name.as_ref() != "minecraft:lava";
+            velocity[1] = match (surface, state.bool_property("drag")) {
+                (true, false) => (velocity[1] + 0.1).min(1.8),
+                (true, true) => (velocity[1] - 0.03).max(-0.9),
+                (false, false) => (velocity[1] + 0.06).min(0.7),
+                (false, true) => (velocity[1] - 0.03).max(-0.3),
+            };
+        }
+        set_motion(ctx.world, id, velocity);
+        let carts = body
+            .entities(ctx.world)
+            .filter(|(_, e)| {
+                e.kind == "minecraft:minecart"
+                    && (0..3)
+                        .map(|i| (e.position[i] - point[i]).powi(2))
+                        .sum::<f64>()
+                        <= 0.2
+            })
+            .map(|(id, _)| id)
+            .collect::<Vec<_>>();
+        for cart in carts {
+            super::rail_cart::collide(ctx.world, cart, id);
+        }
+        Ok(())
+    }
+}
diff --git a/crates/redstone-java-26/src/rules/bubble_column.rs b/crates/redstone-java-26/src/rules/bubble_column.rs
new file mode 100644
index 0000000..2cc5985
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/bubble_column.rs
@@ -0,0 +1,84 @@
+use super::*;
+
+pub(super) fn can_occupy(state: &StateDefinition) -> bool {
+    state.name.as_ref() == "minecraft:bubble_column"
+        || state.name.as_ref() == "minecraft:water" && state.int_property("level") == Some(0)
+}
+
+fn drag_from(state: &StateDefinition) -> Option<bool> {
+    match state.name.as_ref() {
+        "minecraft:soul_sand" => Some(false),
+        "minecraft:magma_block" => Some(true),
+        "minecraft:bubble_column" => Some(state.bool_property("drag")),
+        _ => None,
+    }
+}
+
+impl Java26Rules {
+    pub(super) fn schedule_bubble_column(
+        &self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        state: &StateDefinition,
+        changed: Option<Direction>,
+    ) -> Result<(), RulesError> {
+        let below = self.state(ctx.world.get_block(pos.relative(Direction::Down)))?;
+        let column = state.name.as_ref() == "minecraft:bubble_column";
+        let delay = if column {
+            let above = self.state(ctx.world.get_block(pos.relative(Direction::Up)))?;
+            let extends_up = changed.is_none_or(|d| d == Direction::Up)
+                && above.name.as_ref() == "minecraft:water"
+                && can_occupy(above);
+            if changed != Some(Direction::Down)
+                && drag_from(below) == Some(state.bool_property("drag"))
+                && !extends_up
+            {
+                return Ok(());
+            }
+            5
+        } else {
+            if changed.is_some_and(|d| d != Direction::Down)
+                || !matches!(
+                    below.name.as_ref(),
+                    "minecraft:soul_sand" | "minecraft:magma_block"
+                )
+            {
+                return Ok(());
+            }
+            20
+        };
+        if !ctx.has_scheduled_tick(pos, state.kind) {
+            ctx.schedule_tick(pos, state.kind, delay, TickPriority::Normal);
+        }
+        Ok(())
+    }
+
+    pub(super) fn update_bubble_column(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        mut pos: BlockPos,
+        state: &StateDefinition,
+    ) -> Result<(), RulesError> {
+        let below = self.state(ctx.world.get_block(pos.relative(Direction::Down)))?;
+        let target = match drag_from(below) {
+            Some(drag) => self.registry.state_by_name(
+                "minecraft:bubble_column",
+                [("drag", if drag { "true" } else { "false" })],
+            ),
+            None if state.name.as_ref() == "minecraft:bubble_column" => self
+                .registry
+                .state_by_name("minecraft:water", [("level", "0")]),
+            None => return Ok(()),
+        }
+        .map_err(|e| RulesError::Message(e.to_string()))?;
+        self.set_state_and_update_shapes(ctx, pos, target, "bubble_column")?;
+        loop {
+            pos = pos.relative(Direction::Up);
+            if !can_occupy(self.state(ctx.world.get_block(pos))?)
+                || !self.set_state_and_update_shapes(ctx, pos, target, "bubble_column")?
+            {
+                return Ok(());
+            }
+        }
+    }
+}
