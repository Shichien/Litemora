+    block(&mut reg, &mut world, [0, 0, 0], "stone", &[]);
+    block(&mut reg, &mut world, [0, 1, 0], "stone_pressure_plate", &[]);
+    block(&mut reg, &mut world, [0, 4, 0], "tripwire", &[]);
+    world.spawn_entity(entity("armor_stand", [0.5, 5.0, 0.5], json!({})));
+    let mut sim = sim(reg, world);
+    let mut wire = None;
+    let mut plate = None;
+    for tick in 1..=50 {
+        sim.step().unwrap();
+        if prop(&sim, [0, 4, 0], "powered") == Some("true") {
+            wire.get_or_insert(tick);
+        }
+        if prop(&sim, [0, 1, 0], "powered") == Some("true") {
+            plate.get_or_insert(tick);
+        }
+    }
+    assert!(wire.unwrap() < plate.unwrap());
+    assert_eq!(prop(&sim, [0, 4, 0], "powered"), Some("false"));
+}
