+        let cart = world.spawn_entity(entity(kind, [1.5, 1.0625, 0.5], json!({})));
+        world.spawn_entity(entity("armor_stand", [1.2, 1.0, 0.5], fields));
+        let mut sim = sim(reg, world);
+        for _ in 0..5 {
+            sim.step().unwrap();
+        }
+        assert_eq!(sim.world().entity(cart).unwrap().position[0] > 1.5, push);
+    }
+}
