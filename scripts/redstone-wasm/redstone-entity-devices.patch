+use redstone_core::{Action, BlockPos, EntityData, Simulation, SimulationConfig, SparseWorld};
+use redstone_java_26::{Java26Registry, Java26Rules};
+use serde_json::{Value, json};
+use std::collections::BTreeMap;
+
+fn block(
+    registry: &mut Java26Registry,
+    world: &mut SparseWorld,
+    pos: [i32; 3],
+    name: &str,
+    properties: &[(&str, &str)],
+) {
+    let name = format!("minecraft:{name}");
+    let properties = properties
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect();
+    let full = registry
+        .complete_state_properties(&name, &properties)
+        .unwrap();
+    let state = registry.state_by_name(&name, full).unwrap();
+    world
+        .set_block(BlockPos::new(pos[0], pos[1], pos[2]), state)
+        .unwrap();
+}
+
+fn entity(kind: &str, position: [f64; 3], fields: Value) -> EntityData {
+    EntityData {
+        kind: format!("minecraft:{kind}"),
+        position,
+        fields: serde_json::from_value::<BTreeMap<String, Value>>(fields).unwrap(),
+    }
+}
+
+fn sim(registry: Java26Registry, world: SparseWorld) -> Simulation<Java26Rules> {
+    let mut sim = Simulation::load(
+        Java26Rules::new(registry),
+        world,
+        SimulationConfig::default(),
+    )
+    .unwrap();
+    sim.initialize().unwrap();
+    sim
+}
+
+fn prop<'a>(sim: &'a Simulation<Java26Rules>, pos: [i32; 3], key: &str) -> Option<&'a str> {
+    let state = sim.world().get_block(BlockPos::new(pos[0], pos[1], pos[2]));
+    sim.rules().registry().state(state).unwrap().property(key)
+}
