+    pub(super) fn push_nearby_carts(&self, ctx: &mut EventContext<'_>, id: EntityId) {
+        let cart = ctx.world.entity(id).unwrap();
+        let mut contact_area = Bounds::entity(cart);
+        for i in [0, 2] {
+            contact_area.min[i] -= 0.2;
+            contact_area.max[i] += 0.2;
+        }
+        let neighbors = contact_area
+            .entities(ctx.world)
+            .filter(|(other, e)| *other != id && e.kind.ends_with("minecart"))
+            .map(|(other, _)| other)
+            .collect::<Vec<_>>();
+        // In default Java minecart movement it is the *other* cart that receives push(this).
+        for other in neighbors {
+            collide(ctx.world, other, id);
+        }
+    }
+}
+
+fn yaw(cart: &redstone_core::EntityData) -> f64 {
+    cart.fields
+        .get("Rotation")
+        .and_then(|r| r.get(0))
+        .and_then(Value::as_f64)
+        .unwrap_or(0.0)
+}
+
+pub(super) fn collide(world: &mut SparseWorld, receiver: EntityId, source: EntityId) {
+    let receiver_entity = world.entity(receiver).unwrap();
+    let source_entity = world.entity(source).unwrap();
+    let dx = source_entity.position[0] - receiver_entity.position[0];
+    let dz = source_entity.position[2] - receiver_entity.position[2];
+    let distance = dx.hypot(dz);
+    if distance * distance < f64::from(1e-4_f32) {
+        return;
+    }
+    let impulse = 0.5 * f64::from(0.1_f32) * (1.0 / distance).min(1.0) / distance;
+    let mut receiver_velocity = motion(receiver_entity);
+    let mut source_velocity = motion(source_entity);
+    let source_is_cart = source_entity.kind.ends_with("minecart");
+    if source_is_cart {
+        let (sin, cos) = yaw(receiver_entity).to_radians().sin_cos();
+        if ((dx * cos + dz * sin) / distance).abs() < f64::from(0.8_f32) {
+            return;
+        }
+    }
+    for (axis, impulse_along_axis) in [(0, dx * impulse), (2, dz * impulse)] {
+        if !source_is_cart {
+            receiver_velocity[axis] -= impulse_along_axis;
+            source_velocity[axis] += impulse_along_axis / 4.0;
+        } else {
+            let (receiver_speed, source_speed) = (receiver_velocity[axis], source_velocity[axis]);
+            (receiver_velocity[axis], source_velocity[axis]) =
+                match (receiver_entity.kind.as_str(), source_entity.kind.as_str()) {
+                    ("minecraft:furnace_minecart", other) if other != receiver_entity.kind => (
+                        0.95 * receiver_speed,
+                        0.2 * source_speed + receiver_speed + impulse_along_axis,
+                    ),
+                    (other, "minecraft:furnace_minecart") if other != source_entity.kind => (
+                        0.2 * receiver_speed + source_speed - impulse_along_axis,
+                        0.95 * source_speed,
+                    ),
+                    _ => (
+                        0.2 * receiver_speed + (receiver_speed + source_speed) / 2.0
+                            - impulse_along_axis,
+                        0.2 * source_speed
+                            + (receiver_speed + source_speed) / 2.0
+                            + impulse_along_axis,
+                    ),
+                };
+        }
+    }
+    set_motion(world, receiver, receiver_velocity);
+    set_motion(world, source, source_velocity);
 }
