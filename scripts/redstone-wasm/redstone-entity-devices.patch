+#[derive(Clone, Copy)]
+pub(super) struct Bounds {
+    pub min: [f64; 3],
+    pub max: [f64; 3],
+}
+
+impl Bounds {
+    pub fn entity(entity: &EntityData) -> Self {
+        let [width, height] = dimensions(entity);
+        let [x, y, z] = entity.position;
+        Self {
+            min: [x - width / 2.0, y, z - width / 2.0],
+            max: [x + width / 2.0, y + height, z + width / 2.0],
+        }
+    }
+
+    pub fn intersects(self, other: Self) -> bool {
+        (0..3).all(|i| self.min[i] < other.max[i] && self.max[i] > other.min[i])
+    }
+
+    pub fn cells(self) -> impl Iterator<Item = BlockPos> {
+        let low = entity_block_pos(self.min);
+        let high = entity_block_pos(self.max);
+        (low.x..=high.x).flat_map(move |x| {
+            (low.y..=high.y)
+                .flat_map(move |y| (low.z..=high.z).map(move |z| BlockPos::new(x, y, z)))
+        })
+    }
+
+    pub fn entities(self, world: &SparseWorld) -> impl Iterator<Item = (EntityId, &EntityData)> {
+        // The section index holds entity feet. Widen the candidate query by the
+        // largest vanilla body, then intersect its actual box with the sensor.
+        static MAX_SIZE: LazyLock<[f64; 2]> = LazyLock::new(|| {
+            DIMENSIONS
+                .values()
+                .fold([0.0_f64; 2], |s, v| [s[0].max(v[0]), s[1].max(v[1])])
+        });
+        let half = MAX_SIZE[0] / 2.0;
+        world
+            .entity_ids_in_aabb(
+                [
+                    self.min[0] - half,
+                    self.min[1] - MAX_SIZE[1],
+                    self.min[2] - half,
+                ],
+                [self.max[0] + half, self.max[1], self.max[2] + half],
+            )
+            .into_iter()
+            .filter_map(move |id| {
+                let e = world.entity(id)?;
+                self.intersects(Self::entity(e)).then_some((id, e))
+            })
+    }
+
+    pub fn detector(pos: BlockPos) -> Self {
+        Self::at(pos, [0.2, 0.0, 0.2], [0.8, 0.8, 0.8])
+    }
+
+    pub fn at(pos: BlockPos, min: [f64; 3], max: [f64; 3]) -> Self {
+        let offset = [pos.x as f64, pos.y as f64, pos.z as f64];
+        Self {
+            min: std::array::from_fn(|i| offset[i] + min[i]),
+            max: std::array::from_fn(|i| offset[i] + max[i]),
+        }
+    }
+}
