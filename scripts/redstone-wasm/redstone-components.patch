+fn read_palette_state(entry: &Value) -> Result<(&str, BTreeMap<String, String>), StructureError> {
+    if let Value::String(name) = entry {
+        return Ok((name, BTreeMap::new()));
+    }
+    let Value::Compound(state) = entry else {
+        return Err(StructureError::InvalidType("block state"));
+    };
+    let Some(Value::String(name)) = state.get("id").or_else(|| state.get("Name")) else {
+        return Err(StructureError::MissingField("block state id".to_owned()));
+    };
+    let mut properties = BTreeMap::new();
+    if let Some(value) = state.get("properties").or_else(|| state.get("Properties")) {
+        let Value::Compound(entries) = value else {
+            return Err(StructureError::InvalidType("properties"));
+        };
+        for (key, value) in entries {
+            let Value::String(value) = value else {
+                return Err(StructureError::InvalidType("string property"));
+            };
+            properties.insert(key.clone(), value.clone());
+        }
+    }
+    Ok((name, properties))
+}
