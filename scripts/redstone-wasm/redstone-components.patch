@@ -0,0 +1,398 @@
+use super::*;
+use redstone_core::EntityData;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::collections::BTreeSet;
+use std::sync::LazyLock;
+
+#[derive(Deserialize)]
+struct Shapes {
+    living: BTreeSet<String>,
+    states: Vec<usize>,
+    boxes: Vec<Vec<[f64; 6]>>,
+    resistance: Vec<f32>,
+}
+
+static SHAPES: LazyLock<Shapes> = LazyLock::new(|| {
+    serde_json::from_str(include_str!("../../data/26.1.2/physics.json"))
+        .expect("validated Java collision table")
+});
+
+pub(super) fn triggers_plate(entity: &EntityData, detects_items: bool) -> bool {
+    let truth = |key| {
+        entity
+            .fields
+            .get(key)
+            .is_some_and(|v| v.as_i64() == Some(1) || v.as_bool() == Some(true))
+    };
+    !truth("Marker")
+        && !truth("Spectator")
+        && (detects_items || SHAPES.living.contains(&entity.kind))
+}
+
+fn random(ctx: &mut EventContext<'_>) -> f64 {
+    f64::from(ctx.random_bounded(1 << 24)) / f64::from(1 << 24)
+}
+
+pub(super) fn motion(entity: &EntityData) -> [f64; 3] {
+    let values = entity
+        .fields
+        .get("Motion")
+        .or_else(|| entity.fields.get("motion"))
+        .and_then(Value::as_array);
+    std::array::from_fn(|i| {
+        values
+            .and_then(|a| a.get(i))
+            .and_then(Value::as_f64)
+            .filter(|v| v.abs() <= 10.0)
+            .unwrap_or(0.0)
+    })
+}
+
+fn boxes_in(
+    world: &SparseWorld,
+    min: [f64; 3],
+    max: [f64; 3],
+    mut visit: impl FnMut(BlockPos, [f64; 6]),
+) {
+    for x in min[0].floor() as i32..=max[0].floor() as i32 {
+        // Fences and walls have collision boxes taller than their own voxel.
+        for y in (min[1].floor() as i32).saturating_sub(1)..=max[1].floor() as i32 {
+            for z in min[2].floor() as i32..=max[2].floor() as i32 {
+                let pos = BlockPos::new(x, y, z);
+                let id = world.get_block(pos);
+                if id == world.air() {
+                    continue;
+                }
+                let offsets = [x as f64, y as f64, z as f64];
+                for shape in &SHAPES.boxes[SHAPES.states[id.0 as usize]] {
+                    visit(pos, std::array::from_fn(|i| shape[i] + offsets[i % 3]));
+                }
+            }
+        }
+    }
+}
+
+pub(super) fn swept_entity(
+    world: &SparseWorld,
+    position: [f64; 3],
+    movement: [f64; 3],
+    width: f64,
+    height: f64,
+) -> ([f64; 3], [bool; 3]) {
+    let half = width / 2.0;
+    let mut low = [position[0] - half, position[1], position[2] - half];
+    let mut high = [position[0] + half, position[1] + height, position[2] + half];
+    let mut obstacles = Vec::new();
+    boxes_in(
+        world,
+        std::array::from_fn(|i| low[i] + movement[i].min(0.0)),
+        std::array::from_fn(|i| high[i] + movement[i].max(0.0)),
+        |_, b| obstacles.push(b),
+    );
+    let order = if movement[0].abs() < movement[2].abs() {
+        [1, 2, 0]
+    } else {
+        [1, 0, 2]
+    };
+    let mut clipped = movement;
+    for axis in order {
+        for b in &obstacles {
+            if (0..3).any(|i| i != axis && (high[i] <= b[i] + 1e-7 || low[i] >= b[i + 3] - 1e-7)) {
+                continue;
+            }
+            if clipped[axis] > 0.0 && high[axis] <= b[axis] + 1e-7 {
+                clipped[axis] = clipped[axis].min((b[axis] - high[axis]).max(0.0));
+            }
+            if clipped[axis] < 0.0 && low[axis] >= b[axis + 3] - 1e-7 {
+                clipped[axis] = clipped[axis].max((b[axis + 3] - low[axis]).min(0.0));
+            }
+        }
+        low[axis] += clipped[axis];
+        high[axis] += clipped[axis];
+    }
+    (
+        std::array::from_fn(|i| position[i] + clipped[i]),
+        std::array::from_fn(|i| (movement[i] - clipped[i]).abs() > 1e-7),
+    )
+}
+
+fn ray_hit(
+    world: &SparseWorld,
+    start: [f64; 3],
+    motion: [f64; 3],
+) -> Option<(BlockPos, Direction, [f64; 3], bool)> {
+    let mut hit = None;
+    let mut closest = 1.0_f64;
+    boxes_in(
+        world,
+        std::array::from_fn(|i| start[i] + motion[i].min(0.0)),
+        std::array::from_fn(|i| start[i] + motion[i].max(0.0)),
+        |pos, b| {
+            let inside = (0..3).all(|i| start[i] >= b[i] && start[i] < b[i + 3]);
+            let mut enter = 0.0_f64;
+            let mut leave = closest;
+            let mut face = Direction::Up;
+            for i in 0..3 {
+                if motion[i].abs() < 1e-10 {
+                    if start[i] < b[i] || start[i] > b[i + 3] {
+                        return;
+                    }
+                    continue;
+                }
+                let a = (b[i] - start[i]) / motion[i];
+                let z = (b[i + 3] - start[i]) / motion[i];
+                if a.min(z) >= enter {
+                    enter = a.min(z);
+                    face = if motion[i] > 0.0 {
+                        [Direction::West, Direction::Down, Direction::North][i]
+                    } else {
+                        [Direction::East, Direction::Up, Direction::South][i]
+                    };
+                }
+                leave = leave.min(a.max(z));
+                if enter > leave {
+                    return;
+                }
+            }
+            if enter < closest {
+                closest = enter;
+                hit = Some((
+                    pos,
+                    face,
+                    std::array::from_fn(|i| start[i] + motion[i] * enter),
+                    inside,
+                ));
+            }
+        },
+    );
+    hit
+}
+
+impl Java26Rules {
+    pub(super) fn prime_tnt(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        fuse: i64,
+        cause: &str,
+    ) {
+        let angle = random(ctx) * std::f64::consts::TAU;
+        ctx.world.spawn_entity(EntityData {
+            kind: "minecraft:tnt".into(),
+            position: [pos.x as f64 + 0.5, pos.y as f64, pos.z as f64 + 0.5],
+            fields: BTreeMap::from([
+                ("fuse".into(), json!(fuse)),
+                ("explosion_power".into(), json!(4)),
+                ("ignited_by".into(), json!(cause)),
+                (
+                    "Motion".into(),
+                    json!([-angle.sin() * 0.02, 0.2, -angle.cos() * 0.02]),
+                ),
+            ]),
+        });
+        self.vibrate(ctx, pos, 10, false);
+    }
+
+    pub(super) fn move_tnt(&mut self, ctx: &mut EventContext<'_>, id: EntityId) {
+        let entity = ctx.world.entity(id).unwrap();
+        let mut delta = motion(entity);
+        delta[1] -= 0.04;
+        let (point, blocked) = swept_entity(ctx.world, entity.position, delta, 0.98, 0.98);
+        delta = delta.map(|v| v * 0.98);
+        if blocked[0] {
+            delta[0] = 0.0;
+        }
+        if blocked[2] {
+            delta[2] = 0.0;
+        }
+        if blocked[1] && delta[1] < 0.0 {
+            delta[0] *= 0.7;
+            delta[1] *= -0.5;
+            delta[2] *= 0.7;
+        }
+        ctx.world.move_entity(id, point);
+        ctx.world
+            .entity_fields_mut(id)
+            .unwrap()
+            .insert("Motion".into(), json!(delta));
+    }
+
+    pub(super) fn explode_tnt(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        entity: &EntityData,
+    ) -> Result<(), RulesError> {
+        let mut center = entity.position;
+        let cart = entity.kind == "minecraft:tnt_minecart";
+        if !cart {
+            center[1] += 0.98 * 0.0625;
+        }
+        self.vibrate(ctx, entity_block_pos(center), 15, false);
+        let mut radius = entity
+            .fields
+            .get("explosion_power")
+            .and_then(Value::as_f64)
+            .unwrap_or(4.0)
+            .clamp(0.0, 128.0) as f32;
+        if cart {
+            let velocity = motion(entity);
+            let factor = entity
+                .fields
+                .get("explosion_speed_factor")
+                .and_then(Value::as_f64)
+                .unwrap_or(1.0)
+                .clamp(0.0, 128.0);
+            radius += (factor * random(ctx) * 1.5 * velocity[0].hypot(velocity[2]).min(5.0)) as f32;
+        }
+        let mut affected = BTreeSet::new();
+        for x in 0..16 {
+            for y in 0..16 {
+                for z in 0..16 {
+                    if [x, y, z].iter().all(|&v| v != 0 && v != 15) {
+                        continue;
+                    }
+                    let dir = [x, y, z].map(|v| f64::from(v as f32 / 15.0 * 2.0 - 1.0));
+                    let length = dir.iter().map(|v| v * v).sum::<f64>().sqrt();
+                    let step = dir.map(|v| v / length * f64::from(0.3_f32));
+                    let mut power = radius * (0.7 + random(ctx) as f32 * 0.6);
+                    let mut point = center;
+                    while power > 0.0 {
+                        let pos = entity_block_pos(point);
+                        let id = ctx.world.get_block(pos);
+                        if id != ctx.world.air() {
+                            let state = self.state(id)?;
+                            let mut resistance = SHAPES.resistance[id.0 as usize];
+                            if cart && super::rail_cart::is_track_or_support(self, ctx.world, pos) {
+                                point = std::array::from_fn(|i| point[i] + step[i]);
+                                power -= 0.22500001;
+                                continue;
+                            }
+                            if state.bool_property("waterlogged") {
+                                resistance = resistance.max(100.0);
+                            }
+                            power -= (resistance + 0.3) * 0.3;
+                            if power > 0.0 {
+                                affected.insert(pos);
+                            }
+                        }
+                        for i in 0..3 {
+                            point[i] += step[i];
+                        }
+                        power -= 0.22500001;
+                    }
+                }
+            }
+        }
+        let mut positions: Vec<_> = affected.into_iter().collect();
+        for i in (1..positions.len()).rev() {
+            positions.swap(i, ctx.random_bounded((i + 1) as u32) as usize);
+        }
+        for pos in positions {
+            let state = self.state(ctx.world.get_block(pos))?.clone();
+            if state.behavior == BlockBehavior::Tnt {
+                let fuse = 10 + i64::from(ctx.random_bounded(20));
+                self.prime_tnt(ctx, pos, fuse, "explosion");
+            }
+            self.set_state_and_notify(ctx, pos, self.registry.air_state(), "tnt_explosion", None)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn launch_projectile(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        dir: Direction,
+        item: String,
+    ) {
+        let (dx, dy, dz) = dir.step();
+        let direction = [dx, dy, dz].map(f64::from);
+        let delta = direction
+            .map(|v| (v + (random(ctx) - random(ctx)) * 0.0172275 * 6.0) * f64::from(1.1_f32));
+        let center = [pos.x as f64 + 0.5, pos.y as f64 + 0.6, pos.z as f64 + 0.5];
+        ctx.world.spawn_entity(EntityData {
+            kind: match item.as_str() {
+                "minecraft:tipped_arrow" => "minecraft:arrow",
+                "minecraft:blue_egg" | "minecraft:brown_egg" => "minecraft:egg",
+                name => name,
+            }
+            .into(),
+            position: std::array::from_fn(|i| center[i] + 0.7 * direction[i]),
+            fields: BTreeMap::from([
+                ("source_item".into(), json!(item)),
+                (
+                    "facing".into(),
+                    json!(super::inventory::direction_name(dir)),
+                ),
+                ("Motion".into(), json!(delta)),
+            ]),
+        });
+        self.vibrate(ctx, pos, 3, false);
+    }
+
+    pub(super) fn tick_projectile(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        id: EntityId,
+    ) -> Result<(), RulesError> {
+        let entity = ctx.world.entity(id).unwrap();
+        if entity
+            .fields
+            .get("in_ground")
+            .is_some_and(|v| v.as_bool() == Some(true) || v.as_i64() == Some(1))
+        {
+            return Ok(());
+        }
+        let start = entity.position;
+        let arrow = matches!(
+            entity.kind.as_str(),
+            "minecraft:arrow" | "minecraft:spectral_arrow"
+        );
+        let water = self.state(ctx.world.get_block(entity_block_pos(start)))?;
+        let drag = if water.name.as_ref() == "minecraft:water" || water.bool_property("waterlogged")
+        {
+            if arrow { 0.6_f32 } else { 0.8_f32 }
+        } else {
+            0.99_f32
+        };
+        let mut motion = motion(entity);
+        if !arrow {
+            motion[1] -= 0.03;
+            motion = motion.map(|v| v * f64::from(drag));
+        }
+        if let Some((pos, face, hit, inside)) = ray_hit(ctx.world, start, motion) {
+            let state = self.state(ctx.world.get_block(pos))?.clone();
+            if !inside || !arrow {
+                if state.behavior == BlockBehavior::Target {
+                    self.hit_target(ctx, pos, face, hit, arrow)?;
+                }
+                if state.behavior == BlockBehavior::BigDripleaf {
+                    self.tilt_dripleaf(ctx, pos, &state, "full", 100)?;
+                }
+                self.vibrate(ctx, pos, 2, false);
+            }
+            if !arrow {
+                ctx.world.remove_entity(id);
+                return Ok(());
+            }
+            ctx.world.move_entity(id, hit);
+            let fields = ctx.world.entity_fields_mut(id).unwrap();
+            fields.insert("in_ground".into(), true.into());
+            fields.insert("Motion".into(), json!([0, 0, 0]));
+        } else {
+            let point = std::array::from_fn(|i| start[i] + motion[i]);
+            let mut delta = motion;
+            if arrow {
+                delta = motion.map(|v| v * f64::from(drag));
+                delta[1] -= 0.05;
+            }
+            ctx.world.move_entity(id, point);
+            ctx.world
+                .entity_fields_mut(id)
+                .unwrap()
+                .insert("Motion".into(), json!(delta));
+        }
+        Ok(())
+    }
+}
