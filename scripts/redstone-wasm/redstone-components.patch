@@ -0,0 +1,228 @@
+use super::*;
+use serde::Deserialize;
+use std::sync::LazyLock;
+
+#[derive(Deserialize)]
+struct Recipes {
+    cooking: BTreeMap<String, BTreeMap<String, (Product, i64)>>,
+    fuels: BTreeMap<String, i64>,
+    groups: Vec<Vec<String>>,
+    recipes: Vec<(usize, Vec<Option<usize>>, Product)>,
+}
+
+#[derive(Deserialize)]
+struct Product {
+    id: String,
+    count: Option<i64>,
+    components: Option<Value>,
+}
+
+static RECIPES: LazyLock<Recipes> = LazyLock::new(|| {
+    serde_json::from_str(include_str!("../../../data/26.1.2/crafting.json"))
+        .expect("generated crafting data")
+});
+
+impl Recipes {
+    fn accepts(&self, group: usize, item: &str) -> bool {
+        self.groups[group]
+            .binary_search_by(|name| name.as_str().cmp(item))
+            .is_ok()
+    }
+
+    // Ingredients may overlap (a tag and an exact item). Find a matching
+    // assignment for the at most nine slots, independent of inventory order.
+    fn shapeless(&self, ingredients: &[Option<usize>], stacks: &[ItemStack], used: u16) -> bool {
+        let Some((first, rest)) = ingredients.split_first() else {
+            return true;
+        };
+        stacks.iter().enumerate().any(|(index, stack)| {
+            let bit = 1 << index;
+            used & bit == 0
+                && self.accepts(first.unwrap(), &stack.item_id)
+                && self.shapeless(rest, stacks, used | bit)
+        })
+    }
+
+    fn find(&self, stacks: &[ItemStack]) -> Option<&Product> {
+        if stacks.is_empty() || stacks.iter().any(|s| s.slot >= 9) {
+            return None;
+        }
+        let mut grid = [None; 9];
+        let (mut left, mut top, mut right, mut bottom) = (2, 2, 0, 0);
+        for stack in stacks {
+            let slot = stack.slot as usize;
+            grid[slot] = Some(stack.item_id.as_str());
+            left = left.min(slot % 3);
+            top = top.min(slot / 3);
+            right = right.max(slot % 3);
+            bottom = bottom.max(slot / 3);
+        }
+        let width = right - left + 1;
+        let height = bottom - top + 1;
+        self.recipes
+            .iter()
+            .find_map(|(recipe_width, slots, product)| {
+                let matches = if *recipe_width == 0 {
+                    slots.len() == stacks.len() && self.shapeless(slots, stacks, 0)
+                } else {
+                    *recipe_width == width
+                        && slots.len() == width * height
+                        && [false, true].into_iter().any(|mirror| {
+                            slots.iter().enumerate().all(|(i, group)| {
+                                let column = if mirror {
+                                    width - 1 - i % width
+                                } else {
+                                    i % width
+                                };
+                                match (group, grid[(top + i / width) * 3 + left + column]) {
+                                    (Some(group), Some(item)) => self.accepts(*group, item),
+                                    (None, None) => true,
+                                    _ => false,
+                                }
+                            })
+                        })
+                };
+                matches.then_some(product)
+            })
+    }
+}
+
+pub(super) fn craft(ctx: &mut EventContext<'_>, pos: BlockPos) -> Option<Vec<ItemStack>> {
+    let mut stacks = inventory(ctx.world, pos);
+    let product = RECIPES.find(&stacks)?;
+    let mut outputs = vec![ItemStack {
+        slot: 0,
+        item_id: product.id.clone(),
+        count: product.count.unwrap_or(1),
+        components: product.components.clone(),
+    }];
+    for stack in &mut stacks {
+        stack.count -= 1;
+        let remainder = match stack.item_id.as_str() {
+            "minecraft:water_bucket" | "minecraft:lava_bucket" | "minecraft:milk_bucket" => {
+                "minecraft:bucket"
+            }
+            "minecraft:honey_bottle" | "minecraft:dragon_breath" => "minecraft:glass_bottle",
+            _ => continue,
+        };
+        outputs.push(ItemStack {
+            slot: 0,
+            item_id: remainder.into(),
+            count: 1,
+            components: None,
+        });
+    }
+    stacks.retain(|s| s.count > 0);
+    write_inventory(ctx, pos, stacks);
+    Some(outputs)
+}
+impl Java26Rules {
+    pub(in crate::rules) fn tick_furnace(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        state: &StateDefinition,
+    ) -> Result<(), RulesError> {
+        let counter = |key, legacy| {
+            block_entity_i64(ctx.world, pos, key)
+                .or_else(|| block_entity_i64(ctx.world, pos, legacy))
+                .unwrap_or(0)
+        };
+        let previous_lit = counter("lit_time_remaining", "BurnTime");
+        let previous_time = counter("cooking_time_spent", "CookTime");
+        let mut remaining = (previous_lit - 1).max(0);
+        let mut elapsed = previous_time;
+        let mut total = counter("cooking_total_time", "CookTimeTotal");
+        let mut slots = inventory(ctx.world, pos);
+        let original = slots.clone();
+        let category = match state.name.as_ref() {
+            "minecraft:blast_furnace" => "blasting",
+            "minecraft:smoker" => "smoking",
+            _ => "smelting",
+        };
+        let input = slots.iter().find(|s| s.slot == 0);
+        let fuel = slots.iter().position(|s| s.slot == 1);
+        let wet_sponge = input.is_some_and(|s| s.item_id == "minecraft:wet_sponge");
+        let recipe = input.and_then(|input| RECIPES.cooking[category].get(&input.item_id));
+        let has_ingredients = input.is_some();
+        if remaining > 0 || fuel.is_some() && has_ingredients {
+            if let Some((product, duration)) = recipe {
+                let amount = product.count.unwrap_or(1);
+                let output = slots.iter().position(|s| s.slot == 2);
+                let fits = output.is_none_or(|i| {
+                    slots[i].item_id == product.id
+                        && slots[i].components == product.components
+                        && slots[i].count + amount <= item_stack_limit(None, 2, &product.id)
+                });
+                if fits
+                    && remaining == 0
+                    && let Some(i) = fuel
+                {
+                    remaining = RECIPES.fuels.get(&slots[i].item_id).copied().unwrap_or(0)
+                        / if category == "smelting" { 1 } else { 2 };
+                    if remaining > 0 {
+                        set_block_entity_i64(ctx, pos, "lit_total_time", remaining);
+                        slots[i].count -= 1;
+                        if slots[i].count == 0 && slots[i].item_id == "minecraft:lava_bucket" {
+                            slots[i] = ItemStack {
+                                slot: 1,
+                                item_id: "minecraft:bucket".into(),
+                                count: 1,
+                                components: None,
+                            };
+                        }
+                    }
+                }
+                if remaining > 0 && fits {
+                    if total <= 0 {
+                        total = *duration;
+                    }
+                    elapsed += 1;
+                    if elapsed >= total {
+                        elapsed = 0;
+                        total = *duration;
+                        slots.iter_mut().find(|s| s.slot == 0).unwrap().count -= 1;
+                        if let Some(i) = output {
+                            slots[i].count += amount;
+                        } else {
+                            slots.push(ItemStack {
+                                slot: 2,
+                                item_id: product.id.clone(),
+                                count: amount,
+                                components: product.components.clone(),
+                            });
+                        }
+                        if let Some(i) = fuel
+                            && wet_sponge
+                            && slots[i].item_id == "minecraft:bucket"
+                        {
+                            slots[i].item_id = "minecraft:water_bucket".into();
+                        }
+                    }
+                } else {
+                    elapsed = 0;
+                }
+            } else if !has_ingredients {
+                elapsed = 0;
+            }
+        } else {
+            elapsed = (elapsed - 2).max(0);
+        }
+        if original != slots {
+            write_inventory(ctx, pos, slots);
+            self.refresh_comparators_near(ctx, pos)?;
+        }
+        if previous_lit != remaining {
+            set_block_entity_i64(ctx, pos, "lit_time_remaining", remaining);
+        }
+        if elapsed != previous_time {
+            set_block_entity_i64(ctx, pos, "cooking_time_spent", elapsed);
+            set_block_entity_i64(ctx, pos, "cooking_total_time", total);
+        }
+        if (remaining > 0) != state.lit {
+            let next = self.changed_state(state.id, "lit", (remaining > 0).to_string())?;
+            self.set_state_and_notify(ctx, pos, next, "furnace_burn", None)?;
+        }
+        Ok(())
+    }
+}
