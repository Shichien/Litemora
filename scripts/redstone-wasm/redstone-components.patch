diff --git a/crates/redstone-java-26/src/rules/shelf.rs b/crates/redstone-java-26/src/rules/shelf.rs
new file mode 100644
index 0000000..9b6a7c7
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/shelf.rs
@@ -0,0 +1,95 @@
+use super::*;
+
+fn connections(state: &StateDefinition) -> (bool, bool) {
+    match state.property("side_chain") {
+        Some("left") => (false, true),
+        Some("right") => (true, false),
+        Some("center") => (true, true),
+        _ => (false, false),
+    }
+}
+
+impl Java26Rules {
+    fn connect_shelf(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        left: bool,
+        right: bool,
+    ) -> Result<(), RulesError> {
+        let part = match (left, right) {
+            (true, true) => "center",
+            (true, false) => "right",
+            (false, true) => "left",
+            (false, false) => "unconnected",
+        };
+        let next = self.changed_state(ctx.world.get_block(pos), "side_chain", part)?;
+        self.set_state_and_notify(ctx, pos, next, "shelf_connection", None)?;
+        Ok(())
+    }
+
+    pub(super) fn refresh_shelf(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        state: &StateDefinition,
+        powered: bool,
+    ) -> Result<(), RulesError> {
+        if state.powered == powered {
+            return Ok(());
+        }
+        let facing = state.facing.unwrap();
+        let mut next = self.changed_state(state.id, "powered", powered.to_string())?;
+        next = self.changed_state(next, "side_chain", "unconnected")?;
+        self.set_state_and_notify(ctx, pos, next, "shelf_power", None)?;
+        self.vibrate(ctx, pos, if powered { 10 } else { 9 }, false);
+        let mut length = 1;
+        let mut joins = [false; 2];
+        for (side, direction) in [facing.clockwise(), facing.counter_clockwise()]
+            .into_iter()
+            .enumerate()
+        {
+            let adjacent = pos.relative(direction);
+            let neighbor = self.state(ctx.world.get_block(adjacent))?.clone();
+            if neighbor.behavior != BlockBehavior::Shelf
+                || neighbor.facing != Some(facing)
+                || !neighbor.powered
+            {
+                continue;
+            }
+            let (left, right) = connections(&neighbor);
+            if !powered {
+                self.connect_shelf(ctx, adjacent, left && side == 0, right && side == 1)?;
+                continue;
+            }
+            let mut chain_length = 1;
+            let mut cursor = adjacent;
+            let mut current = &neighbor;
+            while chain_length < 3 {
+                let connections = connections(current);
+                if !(if side == 0 {
+                    connections.0
+                } else {
+                    connections.1
+                }) {
+                    break;
+                }
+                cursor = cursor.relative(direction);
+                current = self.state(ctx.world.get_block(cursor))?;
+                if current.behavior != BlockBehavior::Shelf
+                    || current.facing != Some(facing)
+                    || !current.powered
+                {
+                    break;
+                }
+                chain_length += 1;
+            }
+            if length + chain_length <= 3 {
+                self.connect_shelf(ctx, adjacent, left || side == 1, right || side == 0)?;
+                length += chain_length;
+                joins[side] = true;
+            }
+        }
+        self.connect_shelf(ctx, pos, joins[0], joins[1])
+    }
+}
diff --git a/crates/redstone-java-26/src/rules/vibration.rs b/crates/redstone-java-26/src/rules/vibration.rs
new file mode 100644
index 0000000..9fccbbb
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/vibration.rs
@@ -0,0 +1,239 @@
+use super::*;
+use std::collections::BTreeSet;
+
+#[derive(Clone, Copy)]
+struct Candidate {
+    tick: u64,
+    distance_squared: i64,
+    frequency: u8,
+    player: bool,
+}
+
+#[derive(Default)]
+pub(super) struct Listeners {
+    positions: BTreeSet<BlockPos>,
+    incoming: BTreeMap<BlockPos, Candidate>,
+}
+
+fn is_listener(behavior: BlockBehavior) -> bool {
+    matches!(
+        behavior,
+        BlockBehavior::SculkSensor | BlockBehavior::Shrieker
+    )
+}
+
+impl Java26Rules {
+    pub(super) fn load_listeners(&mut self, world: &SparseWorld) {
+        self.listeners = Listeners::default();
+        for (pos, id) in world.iter_blocks() {
+            if self
+                .registry
+                .state(id)
+                .is_some_and(|s| is_listener(s.behavior))
+            {
+                self.listeners.positions.insert(pos);
+            }
+        }
+    }
+
+    pub(super) fn replace_listener(&mut self, pos: BlockPos, old: BlockStateId, new: BlockStateId) {
+        let old = self.registry.state(old).unwrap();
+        let new = self.registry.state(new).unwrap();
+        if old.kind != new.kind {
+            if is_listener(old.behavior) {
+                self.listeners.incoming.remove(&pos);
+                self.listeners.positions.remove(&pos);
+            }
+            if is_listener(new.behavior) {
+                self.listeners.positions.insert(pos);
+            }
+        }
+    }
+
+    pub fn pending_vibrations(&self) -> usize {
+        self.listeners.incoming.len()
+    }
+
+    // A frequency of zero denotes tendrils clicking, which only shriekers listen to.
+    pub(super) fn vibrate(
+        &mut self,
+        ctx: &EventContext<'_>,
+        source: BlockPos,
+        frequency: u8,
+        player: bool,
+    ) {
+        for &pos in &self.listeners.positions {
+            let dx = i64::from(source.x) - i64::from(pos.x);
+            let dy = i64::from(source.y) - i64::from(pos.y);
+            let dz = i64::from(source.z) - i64::from(pos.z);
+            if dx.abs().max(dy.abs()).max(dz.abs()) > 16 {
+                continue;
+            }
+            let distance_squared = dx * dx + dy * dy + dz * dz;
+            let state = self.registry.state(ctx.world.get_block(pos)).unwrap();
+            let calibrated = state.behavior == BlockBehavior::SculkSensor && state.facing.is_some();
+            let radius = if calibrated { 16 } else { 8 };
+            if distance_squared > radius * radius {
+                continue;
+            }
+            match state.behavior {
+                BlockBehavior::SculkSensor
+                    if frequency != 0
+                        && state.property("sculk_sensor_phase") == Some("inactive") =>
+                {
+                    if let Some(back) = state.facing.map(Direction::opposite) {
+                        let input = self.signal(ctx.world, pos.relative(back), back);
+                        if input != 0 && input != frequency {
+                            continue;
+                        }
+                    }
+                }
+                BlockBehavior::Shrieker
+                    if frequency == 0 && player && !state.bool_property("shrieking") =>
+                {
+                    ()
+                }
+                _ => continue,
+            }
+            if self.listeners.incoming.get(&pos).is_some_and(|old| {
+                old.tick != ctx.tick.0
+                    || old.distance_squared < distance_squared
+                    || old.distance_squared == distance_squared && old.frequency >= frequency
+            }) {
+                continue;
+            }
+            if source != pos && occluded(&self.registry, ctx.world, source, pos) {
+                continue;
+            }
+            self.listeners.incoming.insert(
+                pos,
+                Candidate {
+                    tick: ctx.tick.0,
+                    distance_squared,
+                    frequency,
+                    player,
+                },
+            );
+        }
+    }
+
+    pub(super) fn receive_vibrations(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+    ) -> Result<(), RulesError> {
+        let due: Vec<_> = self
+            .listeners
+            .incoming
+            .iter()
+            .filter_map(|(&pos, &event)| {
+                let distance = (event.distance_squared as f64).sqrt();
+                (ctx.tick.0 >= event.tick + (distance as u64).max(1))
+                    .then_some((pos, distance, event))
+            })
+            .collect();
+        for (pos, distance, event) in due {
+            self.listeners.incoming.remove(&pos);
+            let state = self.state(ctx.world.get_block(pos))?.clone();
+            if state.behavior == BlockBehavior::Shrieker {
+                self.shriek(ctx, pos, &state)?;
+            } else if state.property("sculk_sensor_phase") == Some("inactive") {
+                let (radius, active) = if state.facing.is_some() {
+                    (16.0, 10)
+                } else {
+                    (8.0, 30)
+                };
+                let power = (15 - (15.0 * distance / radius).floor() as i32).max(1);
+                let mut data =
+                    ctx.world
+                        .block_entity(pos)
+                        .cloned()
+                        .unwrap_or_else(|| BlockEntityData {
+                            kind: state.name.to_string(),
+                            fields: BTreeMap::new(),
+                        });
+                data.fields
+                    .insert("last_vibration_frequency".into(), event.frequency.into());
+                ctx.set_block_entity(pos, data);
+                let next = self.changed_state(state.id, "power", power.to_string())?;
+                let next = self.changed_state(next, "sculk_sensor_phase", "active")?;
+                self.set_state_and_notify(ctx, pos, next, "sculk_activate", None)?;
+                ctx.update_neighbors(pos.relative(Direction::Down), state.kind, None, None);
+                ctx.schedule_tick(pos, state.kind, active, TickPriority::Normal);
+                for dir in Direction::UPDATE_ORDER {
+                    let neighbor = pos.relative(dir);
+                    if self.state(ctx.world.get_block(neighbor))?.name.as_ref()
+                        == "minecraft:amethyst_block"
+                    {
+                        self.vibrate(ctx, neighbor, event.frequency, event.player);
+                    }
+                }
+                self.vibrate(ctx, pos, 0, event.player);
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn shriek(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        pos: BlockPos,
+        state: &StateDefinition,
+    ) -> Result<(), RulesError> {
+        if !state.bool_property("shrieking") {
+            let next = self.changed_state(state.id, "shrieking", "true")?;
+            self.set_state_and_notify(ctx, pos, next, "sculk_shriek", None)?;
+            ctx.schedule_tick(pos, state.kind, 90, TickPriority::Normal);
+        }
+        Ok(())
+    }
+}
+
+// Java traces six slightly offset rays. A single unobstructed ray is enough at
+// a wool edge or corner. Ties in voxel traversal are resolved Z, then Y, then X.
+fn occluded(
+    registry: &Java26Registry,
+    world: &SparseWorld,
+    source: BlockPos,
+    dest: BlockPos,
+) -> bool {
+    Direction::UPDATE_ORDER.into_iter().all(|direction| {
+        let (x, y, z) = direction.step();
+        let nudge = [x, y, z];
+        let start = [source.x, source.y, source.z];
+        let end = [dest.x, dest.y, dest.z];
+        let mut cell = start;
+        let mut steps = [0; 3];
+        let mut stride = [f64::INFINITY; 3];
+        let mut next = [f64::INFINITY; 3];
+        for axis in 0..3 {
+            let offset = f64::from(nudge[axis]) * 1e-5;
+            let delta = f64::from(end[axis] - start[axis]) - offset;
+            if delta != 0.0 {
+                steps[axis] = if delta > 0.0 { 1 } else { -1 };
+                stride[axis] = 1.0 / delta.abs();
+                next[axis] = (0.5 - f64::from(steps[axis]) * offset) * stride[axis];
+            }
+        }
+        loop {
+            let id = world.get_block(BlockPos::new(cell[0], cell[1], cell[2]));
+            if registry
+                .state(id)
+                .is_some_and(|s| s.name.ends_with("_wool"))
+            {
+                return true;
+            }
+            if cell == end {
+                return false;
+            }
+            let axis = if next[0] < next[1] && next[0] < next[2] {
+                0
+            } else if next[1] < next[2] {
+                1
+            } else {
+                2
+            };
+            next[axis] += stride[axis];
+            cell[axis] += steps[axis];
+        }
+    })
+}
