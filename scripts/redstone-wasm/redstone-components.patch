@@ -0,0 +1,61 @@
+use super::*;
+
+// Random ticks pick three local coordinates per active 16³ section at the
+// default Java randomTickSpeed. Only lit redstone ore consumes those ticks here.
+#[derive(Default)]
+pub(super) struct OreTicks {
+    sections: BTreeMap<BlockPos, usize>,
+    position_seed: Option<u32>,
+}
+
+impl OreTicks {
+    pub(super) fn track(&mut self, pos: BlockPos, old: &StateDefinition, new: &StateDefinition) {
+        let lit_ore = |s: &StateDefinition| s.behavior == BlockBehavior::RedstoneOre && s.lit;
+        if lit_ore(old) == lit_ore(new) {
+            return;
+        }
+        let section = BlockPos::new(pos.x >> 4, pos.y >> 4, pos.z >> 4);
+        if lit_ore(new) {
+            *self.sections.entry(section).or_default() += 1;
+        } else if let Some(count) = self.sections.get_mut(&section) {
+            *count -= 1;
+            if *count == 0 {
+                self.sections.remove(&section);
+            }
+        }
+    }
+}
+
+impl Java26Rules {
+    pub(super) fn tick_redstone_ore(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+    ) -> Result<(), RulesError> {
+        if self.ore.sections.is_empty() {
+            return Ok(());
+        }
+        let sections: Vec<_> = self.ore.sections.keys().copied().collect();
+        let mut seed = self
+            .ore
+            .position_seed
+            .unwrap_or_else(|| ctx.random_bounded(i32::MAX as u32));
+        for section in sections {
+            for _ in 0..3 {
+                seed = seed.wrapping_mul(3).wrapping_add(1013904223);
+                let bits = seed >> 2;
+                let pos = BlockPos::new(
+                    (section.x << 4) + (bits & 15) as i32,
+                    (section.y << 4) + ((bits >> 16) & 15) as i32,
+                    (section.z << 4) + ((bits >> 8) & 15) as i32,
+                );
+                let state = self.state(ctx.world.get_block(pos))?;
+                if state.behavior == BlockBehavior::RedstoneOre && state.lit {
+                    let next = self.changed_state(state.id, "lit", "false")?;
+                    self.set_state_and_notify(ctx, pos, next, "redstone_ore_random_tick", None)?;
+                }
+            }
+        }
+        self.ore.position_seed = Some(seed);
+        Ok(())
+    }
+}
