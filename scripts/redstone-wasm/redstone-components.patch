diff --git a/crates/redstone-java-26/src/rules/rail_cart.rs b/crates/redstone-java-26/src/rules/rail_cart.rs
new file mode 100644
index 0000000..fa74bbe
--- /dev/null
+++ b/crates/redstone-java-26/src/rules/rail_cart.rs
@@ -0,0 +1,262 @@
+use super::physics::{motion, swept_entity};
+use super::*;
+use serde_json::{Value, json};
+
+struct Rail {
+    pos: BlockPos,
+    a: [i32; 3],
+    b: [i32; 3],
+    state: BlockStateId,
+}
+
+pub(super) fn is_track_or_support(rules: &Java26Rules, world: &SparseWorld, pos: BlockPos) -> bool {
+    [pos, pos.relative(Direction::Up)].into_iter().any(|p| {
+        rules
+            .registry
+            .state(world.get_block(p))
+            .is_some_and(|s| s.name.as_ref() == "minecraft:rail" || s.name.ends_with("_rail"))
+    })
+}
+
+impl Rail {
+    fn at(rules: &Java26Rules, world: &SparseWorld, point: [f64; 3]) -> Option<Self> {
+        let cell = entity_block_pos(point);
+        for pos in [cell.relative(Direction::Down), cell] {
+            let id = world.get_block(pos);
+            let state = rules.registry.state(id)?;
+            if !(state.name.as_ref() == "minecraft:rail" || state.name.ends_with("_rail")) {
+                continue;
+            }
+            let (a, b) = match state.property("shape")? {
+                "north_south" => ([0, 0, -1], [0, 0, 1]),
+                "east_west" => ([-1, 0, 0], [1, 0, 0]),
+                "ascending_east" => ([-1, -1, 0], [1, 0, 0]),
+                "ascending_west" => ([-1, 0, 0], [1, -1, 0]),
+                "ascending_north" => ([0, 0, -1], [0, -1, 1]),
+                "ascending_south" => ([0, -1, -1], [0, 0, 1]),
+                "south_east" => ([0, 0, 1], [1, 0, 0]),
+                "south_west" => ([0, 0, 1], [-1, 0, 0]),
+                "north_west" => ([0, 0, -1], [-1, 0, 0]),
+                "north_east" => ([0, 0, -1], [1, 0, 0]),
+                _ => return None,
+            };
+            return Some(Self {
+                pos,
+                a,
+                b,
+                state: id,
+            });
+        }
+        None
+    }
+
+    fn project(&self, p: [f64; 3]) -> [f64; 3] {
+        let x0 = f64::from(self.pos.x) + 0.5 + 0.5 * f64::from(self.a[0]);
+        let z0 = f64::from(self.pos.z) + 0.5 + 0.5 * f64::from(self.a[2]);
+        let dx = f64::from(self.b[0] - self.a[0]) * 0.5;
+        let dz = f64::from(self.b[2] - self.a[2]) * 0.5;
+        let dy = f64::from(self.b[1] - self.a[1]);
+        let progress = ((p[0] - x0) * dx + (p[2] - z0) * dz) / (dx * dx + dz * dz);
+        [
+            x0 + progress * dx,
+            f64::from(self.pos.y)
+                + 0.0625
+                + 0.5 * f64::from(self.a[1])
+                + dy * progress
+                + if dy < 0.0 {
+                    1.0
+                } else if dy > 0.0 {
+                    0.5
+                } else {
+                    0.0
+                },
+            z0 + progress * dz,
+        ]
+    }
+}
+
+impl Java26Rules {
+    pub(super) fn move_cart(
+        &mut self,
+        ctx: &mut EventContext<'_>,
+        id: EntityId,
+    ) -> Result<(), RulesError> {
+        let cart = ctx.world.entity(id).unwrap().clone();
+        let Some(rail) = Rail::at(self, ctx.world, cart.position) else {
+            return Ok(());
+        };
+        let state = self.state(rail.state)?.clone();
+        let mut delta = motion(&cart);
+        let water = state.bool_property("waterlogged");
+        let slide = if water { 0.0078125 * 0.2 } else { 0.0078125 };
+        for end in [rail.a, rail.b] {
+            if end[1] < 0 {
+                delta[0] += slide * f64::from(end[0]);
+                delta[2] += slide * f64::from(end[2]);
+            }
+        }
+        let dx = f64::from(rail.b[0] - rail.a[0]);
+        let dz = f64::from(rail.b[2] - rail.a[2]);
+        let speed = delta[0].hypot(delta[2]).min(2.0) / dx.hypot(dz)
+            * if delta[0] * dx + delta[2] * dz < 0.0 {
+                -1.0
+            } else {
+                1.0
+            };
+        delta = [speed * dx, 0.0, speed * dz];
+        let powered_rail = state.name.as_ref() == "minecraft:powered_rail";
+        if powered_rail && !state.powered {
+            let factor = if speed.abs() * dx.hypot(dz) < 0.03 {
+                0.0
+            } else {
+                0.5
+            };
+            delta = delta.map(|v| v * factor);
+        }
+        let furnace = cart.kind == "minecraft:furnace_minecart";
+        let max: f64 = if water { 0.2 } else { 0.4 }
+            * if furnace {
+                if water { 0.75 } else { 0.5 }
+            } else {
+                1.0
+            };
+        let old = rail.project(cart.position);
+        let climb = rail.a[1] != rail.b[1];
+        let start = [
+            old[0],
+            f64::from(rail.pos.y) + if climb { 1.0 } else { 0.0 },
+            old[2],
+        ];
+        let (mut point, blocked) = swept_entity(
+            ctx.world,
+            start,
+            delta.map(|v| v.clamp(-max, max)),
+            0.98,
+            0.7,
+        );
+        for end in [rail.a, rail.b] {
+            if end[1] != 0
+                && point[0].floor() as i32 - rail.pos.x == end[0]
+                && point[2].floor() as i32 - rail.pos.z == end[2]
+            {
+                point[1] += f64::from(end[1]);
+            }
+        }
+        let mut drag = 0.96;
+        if cart.kind == "minecraft:chest_minecart" || cart.kind == "minecraft:hopper_minecart" {
+            let fill = super::inventory::container_signal_from_fields(&cart.kind, &cart.fields);
+            drag = 0.98 + f64::from(15 - fill) * 0.001;
+        } else if furnace {
+            let fields = ctx.world.entity_fields_mut(id).unwrap();
+            let fuel = cart.fields.get("Fuel").and_then(Value::as_i64).unwrap_or(0);
+            let push = |field| {
+                cart.fields
+                    .get(field)
+                    .and_then(Value::as_f64)
+                    .unwrap_or(0.0)
+            };
+            let (mut px, mut pz) = (push("PushX"), push("PushZ"));
+            if fuel > 0 && px.hypot(pz) > 1e-4 {
+                let length = delta[0].hypot(delta[2]);
+                if length * length > 0.001 && px.hypot(pz).powi(2) > 1e-4 {
+                    let scale = px.hypot(pz) / length
+                        * if px * delta[0] + pz * delta[2] < 0.0 {
+                            -1.0
+                        } else {
+                            1.0
+                        };
+                    px = delta[0] * scale;
+                    pz = delta[2] * scale;
+                }
+                delta[0] = delta[0] * 0.8 + px;
+                delta[2] = delta[2] * 0.8 + pz;
+                if water {
+                    delta = delta.map(|v| v * 0.1);
+                }
+            } else {
+                delta = delta.map(|v| v * 0.98);
+            }
+            if fuel > 0 {
+                fields.insert("Fuel".into(), json!(fuel - 1));
+            }
+            if fuel <= 1 {
+                px = 0.0;
+                pz = 0.0;
+            }
+            if cart.fields.contains_key("PushX") {
+                fields.insert("PushX".into(), json!(px));
+            }
+            if cart.fields.contains_key("PushZ") {
+                fields.insert("PushZ".into(), json!(pz));
+            }
+        }
+        if water {
+            drag *= 0.95;
+        }
+        delta = delta.map(|v| v * drag);
+        if let Some(next) = Rail::at(self, ctx.world, point) {
+            let new = next.project(point);
+            let speed = delta[0].hypot(delta[2]);
+            if speed > 0.0 {
+                let scale = 1.0 + (old[1] - new[1]) * 0.05 / speed;
+                delta[0] *= scale;
+                delta[2] *= scale;
+            }
+            point[1] = new[1];
+        }
+        let next = entity_block_pos(point);
+        if next.x != rail.pos.x || next.z != rail.pos.z {
+            let speed = delta[0].hypot(delta[2]);
+            delta[0] = speed * f64::from(next.x - rail.pos.x);
+            delta[2] = speed * f64::from(next.z - rail.pos.z);
+        }
+        if powered_rail && state.powered {
+            let speed = delta[0].hypot(delta[2]);
+            if speed > 0.01 {
+                delta[0] += delta[0] * 0.06 / speed;
+                delta[2] += delta[2] * 0.06 / speed;
+            } else if let Some((axis, from, to)) = match state.property("shape") {
+                Some("east_west") => Some((0, Direction::West, Direction::East)),
+                Some("north_south") => Some((2, Direction::North, Direction::South)),
+                _ => None,
+            } {
+                let solid = |dir| {
+                    self.registry
+                        .state(ctx.world.get_block(rail.pos.relative(dir)))
+                        .unwrap()
+                        .redstone_conductor
+                };
+                if solid(from) {
+                    delta[axis] = 0.02;
+                } else if solid(to) {
+                    delta[axis] = -0.02;
+                }
+            }
+        }
+        if cart.position != point {
+            ctx.world.move_entity(id, point);
+        }
+        let fields = ctx.world.entity_fields_mut(id).unwrap();
+        if delta != [0.0; 3] || fields.contains_key("Motion") {
+            fields.insert("Motion".into(), json!(delta));
+        }
+        if cart.kind == "minecraft:tnt_minecart" {
+            let mut fuse = cart
+                .fields
+                .get("fuse")
+                .or_else(|| cart.fields.get("TNTFuse"))
+                .and_then(Value::as_i64)
+                .unwrap_or(-1);
+            if fuse < 0 && state.name.as_ref() == "minecraft:activator_rail" && state.powered {
+                fuse = 80;
+            }
+            if fuse == 0 || (blocked[0] || blocked[2]) && delta[0].hypot(delta[2]) >= 0.1 {
+                let cart = ctx.world.remove_entity(id).unwrap();
+                self.explode_tnt(ctx, &cart)?;
+            } else if fuse > 0 {
+                fields.insert("fuse".into(), json!(fuse - 1));
+            }
+        }
+        Ok(())
+    }
+}
