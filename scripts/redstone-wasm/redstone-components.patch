+#[test]
+fn honey_bottle_crafting_sends_the_block_and_four_bottles_to_the_chest() {
+    let mut registry = Java26Registry::new();
+    let crafter = state(
+        &mut registry,
+        "minecraft:crafter",
+        &[
+            ("crafting", "false"),
+            ("orientation", "east_up"),
+            ("triggered", "false"),
+        ],
+    );
+    let chest = state(
+        &mut registry,
+        "minecraft:chest",
+        &[
+            ("facing", "north"),
+            ("waterlogged", "false"),
+            ("type", "single"),
+        ],
+    );
+    let power = state(&mut registry, "minecraft:redstone_block", &[]);
+    let target = BlockPos::new(1, 0, 0);
+    let mut world = SparseWorld::new(registry.air_state());
+    world.set_block(BlockPos::ZERO, crafter).unwrap();
+    world.set_block(target, chest).unwrap();
+    world.set_block(BlockPos::new(0, 1, 0), power).unwrap();
+    let mut data = container("minecraft:crafter", &[("minecraft:honey_bottle", 1); 4]);
+    for (item, slot) in data.fields.get_mut("inventory").unwrap()
+        .as_array_mut()
+        .unwrap()
+        .iter_mut()
+        .zip([0, 1, 3, 4])
+    {
+        item["slot"] = slot.into();
+    }
+    world.set_block_entity(BlockPos::ZERO, data);
+    world.set_block_entity(target, container("minecraft:chest", &[]));
+    let mut simulation = Simulation::load(
+        Java26Rules::new(registry),
+        world,
+        SimulationConfig::default(),
+    )
+    .unwrap();
+    simulation.initialize().unwrap();
+    simulation.run_until(redstone_core::GameTick(12)).unwrap();
+    let output = simulation.world().block_entity(target).unwrap();
+    assert_eq!(
+        output.fields["inventory"],
+        serde_json::json!([
+            {"slot":0,"item_id":"minecraft:honey_block","count":1},
+            {"slot":1,"item_id":"minecraft:glass_bottle","count":4}
+        ])
+    );
+    assert_eq!(
+        simulation
+            .world()
+            .block_entity(BlockPos::ZERO)
+            .unwrap()
+            .fields["item_count"],
+        0
+    );
+}
